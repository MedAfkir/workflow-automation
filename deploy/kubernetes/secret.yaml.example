apiVersion: v1
kind: Secret
metadata:
  name: workflow-secrets
  namespace: workflow
  labels:
    app.kubernetes.io/name: workflow-platform
    app.kubernetes.io/component: app-api
type: Opaque
stringData:

  WORKFLOW_SECRET_MASTER_KEY: REPLACE_WITH_BASE64_32_BYTES
  SPRING_DATASOURCE_USERNAME: workflow
  SPRING_DATASOURCE_PASSWORD: REPLACE_WITH_DB_PASSWORD
